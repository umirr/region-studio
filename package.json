{
  "name": "region-studio-desktop",
  "version": "0.6.0",
  "description": "Offline illustration region recoloring and annotation",
  "author": "Region Studio",
  "main": "main.cjs",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dist:win": "npm run prepare-assets && electron-builder --win nsis"
  },
  "build": {
    "appId": "local.regionstudio.desktop",
    "productName": "Region Studio",
    "electronVersion": "44.3.0",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "storage.cjs",
      "ui/**/*",
      "LICENSES/**/*",
      "submission.cjs",
      "cloud-upload.cjs"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Region-Studio-Setup-${version}.${ext}"
    },
    "directories": {
      "output": "../region-studio-windows"
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "3.5.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4"
  }
}